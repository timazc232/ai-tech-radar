{
  "name": "ai-tech-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:dev": "tsx workers/cli.ts",
    "worker:build": "tsup workers/cli.ts --format esm --dts --out-dir dist",
    "worker:daily": "tsx workers/cli.ts daily",
    "worker:backfill": "tsx workers/cli.ts daily_backfill",
    "worker:backup": "tsx workers/cli.ts backup",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "drizzle-orm": "^0.38.4",
    "better-sqlite3": "^13.0.3",
    "zod": "^3.24.1",
    "@t3-oss/env-nextjs": "^0.11.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "rss-parser": "^3.13.0",
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "drizzle-kit": "^0.30.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "@tailwindcss/postcss": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vitest": "^2.1.8",
    "@playwright/test": "^1.49.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6"
  }
}
