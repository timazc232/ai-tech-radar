# ===== 必备 =====
# GitHub API token (GitHub 采集器必备). 获取: https://github.com/settings/tokens/new
GITHUB_TOKEN=

# SQLite 数据库文件路径
DATABASE_PATH=./data/radar.db

# 数据窗口时区（固定北京时间）
TIMEZONE=Asia/Shanghai

# ===== 社区 API（可选；缺失时安全跳过）=====
# X Developer recent search Bearer Token
X_BEARER_TOKEN=
# Reddit script/web app credentials（使用官方 OAuth client_credentials）
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-tech-radar/0.1 by local-user

# ===== LLM（Week 2+）=====
# 可选: deepseek | anthropic | openai | openrouter
LLM_PROVIDER=deepseek
# DeepSeek key 获取: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
LLM_STRONG_MODEL=deepseek-chat
LLM_CHEAP_MODEL=deepseek-chat
# 每日 LLM 预算硬上限（元）
LLM_DAILY_BUDGET_YUAN=10

# 仅当 LLM_PROVIDER=anthropic 时需要
ANTHROPIC_API_KEY=

# ===== 远程访问（可选）=====
# 手动触发任务的 admin token: openssl rand -hex 32
ADMIN_TOKEN=
# 绑定地址，默认仅本机访问
BIND_HOST=127.0.0.1
